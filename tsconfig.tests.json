{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "outDir": ".test-dist",
    "rootDir": ".",
    "strict": false
  },
  "include": [
    "src/config/site.ts",
    "src/config/seo-meta.ts",
    "src/routing.ts",
    "src/utils/seo.ts",
    "tests/seo-regression.test.ts",
    "src/locales/routes.json",
    "src/api/leadContract.ts",
    "src/utils/leadSubmission.ts",
    "tests/lead-contract.test.ts"
  ]
}
